# Порт локального сервера (на Render не обов’язково)
PORT=3000

# Дані для MongoDB
MONGODB_USER=your_mongo_user
MONGODB_PASSWORD=your_mongo_password
MONGODB_URL=your_mongo_host_url   # приклад: cluster0.mongodb.net
MONGODB_DB=your_database_name

# SMTP налаштування (для надсилання листів)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=Your App Name <your_email@example.com>

# JWT секрет для генерації токенів
JWT_SECRET=your_super_secret_key

# Домен додатку (використовується в листах/редіректах)
APP_DOMAIN=https://yourapp.onrender.com

# Cloudinary (зберігання зображень)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Якщо true — завантаження файлів йде в Cloudinary, якщо false — локально
UPLOAD_TO_CLOUDINARY=true
# UPLOAD_TO_CLOUDINARY=false